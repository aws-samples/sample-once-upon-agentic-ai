{
  "$schema": "https://schema.agentcore.aws.dev/v1/agentcore.json",
  "name": "dndprod",
  "version": 1,
  "managedBy": "CDK",
  "tags": {
    "agentcore:created-by": "agentcore-cli",
    "agentcore:project-name": "dndprod"
  },
  "runtimes": [
    {
      "name": "diceserver",
      "build": "CodeZip",
      "entrypoint": "dice_roll_mcp_server.py",
      "codeLocation": "../diceserver/",
      "runtimeVersion": "PYTHON_3_14",
      "networkMode": "PUBLIC",
      "instrumentation": {
        "enableOtel": false
      },
      "protocol": "MCP"
    },
    {
      "name": "characteragent",
      "build": "CodeZip",
      "entrypoint": "character_agent.py",
      "codeLocation": "../characteragent/",
      "runtimeVersion": "PYTHON_3_14",
      "networkMode": "PUBLIC",
      "protocol": "A2A",
      "additionalPolicies": [
        "memory-policy.json"
      ]
    }
  ],
  "memories": [
    {
      "name": "characters",
      "eventExpiryDuration": 365,
      "strategies": []
    }
  ],
  "knowledgeBases": [],
  "credentials": [],
  "evaluators": [],
  "onlineEvalConfigs": [],
  "agentCoreGateways": [],
  "policyEngines": [],
  "configBundles": [],
  "abTests": [],
  "harnesses": [],
  "datasets": [],
  "capacityProviders": [],
  "payments": []
}
