{
  "name": "Once Upon Agentic AI",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.13-bullseye",

  // Install uv after the container is created, then sync all Python dependencies.
  "postCreateCommand": "bash .devcontainer/setup.sh",

  // Forward ports used by the workshop chapters.
  // Chapter 4: MCP server  Chapter 7: Strands harness API
  "forwardPorts": [8080, 8000],
  "portsAttributes": {
    "8080": { "label": "MCP server (ch 4)", "onAutoForward": "notify" },
    "8000": { "label": "Strands harness / A2A (ch 5 & 7)", "onAutoForward": "notify" }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff",
        "humao.rest-client"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
        "python.venvPath": "${workspaceFolder}",
        "python.terminal.activateEnvironment": true,
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff",
          "editor.formatOnSave": true
        }
      }
    }
  }
}
