# Copy to .env and adjust as needed. See README "Prerequisites" for details.

# AWS region with Bedrock model availability (examples use us-east-1).
AWS_REGION=us-east-1

# Optional: choose the Bedrock model.
# The chapters use the Strands SDK default (an Anthropic Claude model), which
# requires the one-time Anthropic "use case details" form on your account.
# To run without that form, use an Amazon Nova model by passing it to Agent(...),
# for example: BedrockModel(model_id="us.amazon.nova-lite-v1:0").
# Example values:
#   us.amazon.nova-lite-v1:0                       (no use-case form required)
#   us.anthropic.claude-sonnet-4-5-20250929-v1:0   (needs the Anthropic form)
# BEDROCK_MODEL_ID=us.amazon.nova-lite-v1:0

# AWS credentials come from your standard credential chain (env, profile, or role):
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
